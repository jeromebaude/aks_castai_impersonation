# macOS / IDE
.DS_Store
.idea/

# Terraform working directory, provider plugins and lock file
.terraform*
terraform.d/

# Local state and plan files
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local variable files (may contain secrets such as the CAST AI API token)
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform examples
examples/**/.kube/
